# Local development only. Never commit .env.
POSTGRES_USER=sam
POSTGRES_PASSWORD=sam
POSTGRES_DB=sam
DATABASE_URL=postgresql+psycopg://sam:sam@postgres:5432/sam
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-me-local-only
AGENT_API_KEY=replace-me-agent-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_BACKEND=pgvector
LOG_LEVEL=INFO
BACKEND_IMAGE=sam-backend:dev
WEB_IMAGE=sam-web:dev
